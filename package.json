{
  "name":"indian-web-browser",
  "version":"1.0.0",
  "description":"Indian Web Browser - lightweight cross-platform browser",
  "author":"Indian Web Browser",
  "main":"src/main.js",
  "scripts":{
    "start":"electron .",
    "build:win":"electron-builder --win --publish never",
    "build:linux":"electron-builder --linux --publish never",
    "build:android":"echo Use Android Studio/Gradle"
  },
  "devDependencies":{
    "electron":"^38.0.0",
    "electron-builder":"^26.0.0"
  },
  "build":{
    "appId":"in.indianweb.browser",
    "productName":"Indian Web Browser",
    "linux":{"target":["AppImage","deb"],"category":"Network;WebBrowser"},
    "win":{"target":["nsis","portable"]}
  }
}